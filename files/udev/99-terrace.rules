# udev rules for Terrace

# NVIDIA
KERNEL=="nvidia", RUN+="/usr/bin/nvidia-modprobe -c 0 -u"
KERNEL=="nvidia_uvm", RUN+="/usr/bin/nvidia-modprobe -c 0 -u"
KERNEL=="nvidia_modeset", RUN+="/usr/bin/nvidia-modprobe -c 0 -u"

# Input devices
SUBSYSTEM=="input", KERNEL=="event*", TAG+="seat"

# DRM/KMS
SUBSYSTEM=="drm", KERNEL=="card*", TAG+="seat", TAG+="master-of-seat"

# Video devices
SUBSYSTEM=="video4linux", TAG+="seat"

# Sound devices
SUBSYSTEM=="sound", TAG+="seat"